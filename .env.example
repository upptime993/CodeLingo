# Environment Variables untuk CodeLingo
# Copy file ini menjadi .env.local dan isi nilai yang sesuai

# ========== DATABASE ==========
# Dapatkan dari: https://cloud.mongodb.com/
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/codelingo?retryWrites=true&w=majority

# ========== NEXTAUTH ==========
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000
