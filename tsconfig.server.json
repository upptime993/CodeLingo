{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist-server",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": ["server/**/*", "api/**/*"],
  "exclude": ["src", "node_modules"]
}
